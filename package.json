{
  "name": "vue",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "scripts": {
    "serve": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service serve",
    "dev": "set NODE_OPTIONS=--openssl-legacy-provider --max-old-space-size=4096 && vue-cli-service serve",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build",
    "build:prod": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build --mode production",
    "build:dev": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build --mode development",
    "lint": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service lint",
    "devtools": "npx --yes @vue/devtools@5"
  },
  "dependencies": {
    "@zxing/library": "^0.19.2",
    "animate.css": "^4.1.1",
    "axios": "^0.19.0",
    "babel-polyfill": "^6.26.0",
    "crypto-js": "^4.2.0",
    "element-ui": "^2.15.13",
    "vue": "^2.6.10",
    "vue-count-to": "^1.0.13",
    "vue-fullpage": "^2.0.5",
    "vue-fullpage.js": "^0.2.15",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^3.6.5",
    "vuex": "^3.1.1",
    "vuex-persistedstate": "^2.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.5.5",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.5.5",
    "@babel/preset-env": "^7.5.5",
    "@vue/cli-plugin-babel": "^3.11.0",
    "@vue/cli-plugin-eslint": "^3.11.0",
    "@vue/cli-service": "^3.11.0",
    "babel-eslint": "^10.0.2",
    "babel-polyfill": "^6.26.0",
    "chokidar": "^4.0.3",
    "compression-webpack-plugin": "^3.0.0",
    "eslint": "^6.2.2",
    "eslint-plugin-vue": "^5.2.3",
    "image-webpack-loader": "^5.0.0",
    "less": "^3.10.3",
    "less-loader": "^5.0.0",
    "postcss": "^8.4.38",
    "postcss-preset-env": "^9.5.14",
    "postcss-pxtorem": "^5.1.1",
    "svg-sprite-loader": "^6.0.9",
    "vue-hot-reload-api": "^2.3.3",
    "vue-loader": "^15.7.1",
    "vue-template-compiler": "^2.6.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {},
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
